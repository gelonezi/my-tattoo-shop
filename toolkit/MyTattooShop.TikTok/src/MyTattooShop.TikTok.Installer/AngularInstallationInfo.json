{
  "packages":[
    {
      "appRoutingModuleConfiguration":{
        "imports":[
          {
            "names":[
              "TIK_TOK_ROUTES"
            ],
            "namespace": "@my-tattoo-shop/tik-tok"
          } 
        ],
        "routes":[
          "{ path: 'tik-tok', children: TIK_TOK_ROUTES, canActivate: [authGuard] }"
        ]
      },
      "appModuleConfiguration":{
        "imports":[
          {
            "names":[
              "provideTikTok"
            ],
            "namespace": "@my-tattoo-shop/tik-tok/config"
          }
        ],
        "providerNames":[
          "provideTikTok()"
        ]
      },
      "tsJsonPathRecordConfigurations":[
        {
          "name": "@my-tattoo-shop/tik-tok",
          "paths": [
            "angular/projects/tik-tok/src/public-api.ts"
          ]
        },
        {
          "name": "@my-tattoo-shop/tik-tok/config",
          "paths": [
            "angular/projects/tik-tok/config/src/public-api.ts"
          ]
        }
      ]
    }
  ]
}