{
  "packages":[
    {
      "appRoutingModuleConfiguration":{
        "imports":[
          {
            "names":[
              "CALENDAR_ROUTES"
            ],
            "namespace": "@my-tattoo-shop/calendar"
          } 
        ],
        "routes":[
          "{ path: 'calendar', children: CALENDAR_ROUTES, canActivate: [authGuard] }"
        ]
      },
      "appModuleConfiguration":{
        "imports":[
          {
            "names":[
              "provideCalendar"
            ],
            "namespace": "@my-tattoo-shop/calendar/config"
          }
        ],
        "providerNames":[
          "provideCalendar()"
        ]
      },
      "tsJsonPathRecordConfigurations":[
        {
          "name": "@my-tattoo-shop/calendar",
          "paths": [
            "angular/projects/calendar/src/public-api.ts"
          ]
        },
        {
          "name": "@my-tattoo-shop/calendar/config",
          "paths": [
            "angular/projects/calendar/config/src/public-api.ts"
          ]
        }
      ]
    }
  ]
}