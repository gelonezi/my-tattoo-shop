{
  "App": {
    "SelfUrl": "https://localhost:44366",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.MyTattooShop.com,http://localhost:4200,",
    "RedirectAllowedUrls": "http://localhost:4200,",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
